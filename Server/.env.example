# Copy this file to Server/.env and fill in real values.
# Server/.env is git-ignored and must never be committed with real secrets.

# Port the Express server listens on
PORT=5000

# Existing MongoDB Atlas connection string (do not replace or commit real credentials)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?appName=<app-name>

# Frontend origin(s) allowed to call this API. On Render, replace the
# placeholder with the deployed Vercel production origin (no trailing slash).
# Multiple allowed origins, such as a production custom domain and Vercel
# preview domain, are comma-separated.
CLIENT_URL=https://<your-vercel-production-domain>

# Part 2 - authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<long-random-secret>
# JWT lifetime, e.g. 15m, 1h, 1d, 7d
JWT_EXPIRES_IN=1d

# Part 2 - email verification
# How long a verification link stays valid (ms, s, m, h, d)
EMAIL_VERIFICATION_EXPIRES_IN=1h
# Minimum wait between "resend verification email" requests
EMAIL_VERIFICATION_RESEND_COOLDOWN=60s
# Set to false to allow login without a verified email (not recommended)
REQUIRE_EMAIL_VERIFICATION=true

# SMTP (optional). If SMTP_HOST is empty the app runs in dev mode and prints the
# verification link to the server console instead of sending an email.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
MAIL_FROM=RicozSpend <no-reply@ricozspend.local>
